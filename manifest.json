{
  "identifier": "com.salmanff.orbit",
  "display_name": "Orbit",
  "version": "0.1.0",
  "description": "Build and publish multi-page sites",
  "app_url": "https://github.com/salmanff/com.salmanff.orbit",
  "manifest_url": "https://github.com/salmanff/com.salmanff.orbit/blob/main/manifest.json",
  "pages": {
    "index": {
      "page_title": "Orbit",
      "html_file": "index.html",
      "css_files": [
        "orbit.css",
        "globe.css"
      ],
      "script_files": [
        "orbit.js"
      ]
    }
  },
  "files": {
    "do_not_allow": false,
    "post_data_html_id": "file",
    "strictly_Adhere_To_schema": false,
    "donot_auto_enumerate_duplicates": false,
    "allowed_file_types": null,
    "field_names": {
      "name": {
        "description": "File Name",
        "type": "string",
        "required": true
      }
    }
  },
  "public_pages": {},
  "app_tables": {
    "projects": {
      "field_names": {
        "name": {
          "type": "string",
          "description": "Stable project id (folder name)"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "published": {
          "type": "boolean"
        },
        "public_url": {
          "type": "string"
        },
        "entry_page": {
          "type": "string"
        },
        "pages": {
          "type": "object",
          "description": "Page specs with html_file, css_files, js_files"
        }
      }
    },
    "chat_history": {
      "field_names": {
        "project_name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "active_page": {
          "type": "string"
        },
        "files_changed": {
          "type": "array"
        }
      }
    }
  },
  "permissions": [
    {
      "name": "publish_site",
      "type": "upload_pages",
      "description": "Publish site files publicly"
    },
    {
      "name": "allow_iframe_preview",
      "type": "allow_self_frames",
      "description": "Allow in-app iframe preview for draft pages"
    },
    {
      "name": "use_llm",
      "type": "use_llm",
      "description": "Use AI to help edit site files"
    }
  ]
}
